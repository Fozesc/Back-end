# ==========================================================================
# CONFIGURAÇÃO DO BACKEND (rodar LOCAL)
#
#   Para rodar na sua máquina:  cp .env.example .env   (e ajuste os valores)
#
#   Em PRODUÇÃO / deploy (Docker) este arquivo NÃO é usado — as variáveis
#   vêm do docker-compose. Este .env está no .gitignore e no .dockerignore,
#   então nunca vai pro git nem pra imagem do servidor.
# ==========================================================================

# --- OBRIGATÓRIAS (o backend não sobe sem elas) ---

# Conexão com o banco. Ex. LOCAL apontando pro Postgres do Docker (localhost:5433):
DATABASE_URL=postgresql://fozesc_db:fozesc_db@localhost:5433/fozesc_db

# Chave usada para assinar os tokens de login. Use uma chave forte de verdade.
JWT_SECRET_KEY=troque-esta-chave-secreta

# --- OPCIONAIS (referência / flask cli) ---
FLASK_APP=run.py
FLASK_ENV=development
